# ============================================================
# ROOT .env.example
# Used by: Docker Compose only
# Copy to .env and fill in real values before running
#   cp .env.example .env
#
# DO NOT put application-level secrets here.
# Each service (backend/, frontend/, optimization/) has its own .env
# ============================================================

# ── PostgreSQL container ─────────────────────────────────────
# These are read by the 'db' service in docker-compose.yml
POSTGRES_DB=ev_renewable_db
POSTGRES_USER=ev_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ── Service ports (used by docker-compose port mappings) ─────
BACKEND_PORT=8080
OPTIMIZATION_PORT=8001
FRONTEND_PORT=80

# ── Docker Compose active profile ────────────────────────────
# Options: dev | prod
COMPOSE_PROFILE=dev

# ── Nginx ────────────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443