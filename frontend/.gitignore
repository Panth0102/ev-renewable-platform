# ============================================================
# frontend/.gitignore — React + Vite + Node.js
# ============================================================

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build output ─────────────────────────────────────────────
dist/
build/

# ── Vite cache ───────────────────────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── Test coverage ────────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc ─────────────────────────────────────────────────────
.cache/
.parcel-cache/
*.local

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ── TypeScript (if added later) ──────────────────────────────
*.tsbuildinfo
