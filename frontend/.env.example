# ============================================================
# frontend/.env.example
# Used by: Vite (React app)
# Copy to .env and fill in real values:
#   cp frontend/.env.example frontend/.env
#
# IMPORTANT: Only variables prefixed with VITE_ are exposed
# to the browser bundle. Never put backend secrets here.
# ============================================================

# ── API endpoints ────────────────────────────────────────────
# Points to Spring Boot backend
# Local dev:  http://localhost:8080/api
# Docker/prod: /api  (relative — handled by Nginx proxy)
VITE_API_BASE_URL=http://localhost:8080/api

# Points to FastAPI optimization service
# Local dev:  http://localhost:8001
# Docker/prod: /optimization
VITE_OPTIMIZATION_URL=http://localhost:8001

# ── App metadata ─────────────────────────────────────────────
VITE_APP_NAME=EV Renewable Platform
VITE_APP_VERSION=1.0.0

# ── Map configuration (Leaflet + OpenStreetMap) ──────────────
# Default tile layer — OpenStreetMap (free, no API key required)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Default map centre [lat, lng] and zoom
VITE_MAP_DEFAULT_LAT=20.5937
VITE_MAP_DEFAULT_LNG=78.9629
VITE_MAP_DEFAULT_ZOOM=5

# ── Feature flags ────────────────────────────────────────────
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=false

# ── Auth ─────────────────────────────────────────────────────
# Token storage key in localStorage
VITE_TOKEN_KEY=ev_access_token
VITE_REFRESH_TOKEN_KEY=ev_refresh_token
