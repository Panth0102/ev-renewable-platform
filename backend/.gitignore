# ============================================================
# backend/.gitignore — Java + Spring Boot + Maven
# ============================================================

# ── Environment ──────────────────────────────────────────────
.env
.env.local
!.env.example

# ── Maven build output ───────────────────────────────────────
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── Compiled Java ────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*

# ── Spring Boot ──────────────────────────────────────────────
# Don't commit generated spring config
spring-shell.log

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
!logs/.gitkeep

# ── IntelliJ IDEA ────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/

# ── Eclipse / STS ────────────────────────────────────────────
.classpath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# ── VS Code ──────────────────────────────────────────────────
.vscode/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets / keystores ──────────────────────────────────────
*.jks
*.keystore
*.p12
*.pem
*.key
