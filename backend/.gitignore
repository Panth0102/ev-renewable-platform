# ============================================================
# backend/.gitignore — Java 11 + Spring Boot + Maven
# ============================================================

# ── Environment (secrets live here — never commit) ───────────
.env
.env.local
!.env.example

# ── Maven build output ───────────────────────────────────────
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# Keep the wrapper jar if you use mvnw
.mvn/wrapper/maven-wrapper.jar

# ── Compiled Java ────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ── Spring Boot specific ─────────────────────────────────────
spring-shell.log
# Local override properties (developer-specific, not for CI)
application-local.properties

# ── Logs ─────────────────────────────────────────────────────
*.log
*.log.*
logs/
!logs/.gitkeep

# ── IntelliJ IDEA ────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# ── Eclipse / STS ────────────────────────────────────────────
.classpath
.project
.settings/
.springBeans
.sts4-cache/
bin/
.factorypath

# ── VS Code / Cursor ─────────────────────────────────────────
.vscode/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets / keystores ──────────────────────────────────────
*.jks
*.keystore
*.p12
*.pem
*.key

# ── MapStruct / Lombok generated (compiled, not source) ──────
# These are in target/ already — belt-and-braces
generated-sources/
generated-test-sources/
