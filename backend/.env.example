# ============================================================
# backend/.env.example
# Used by: Spring Boot (application.properties via ${VAR} syntax)
# Copy to .env and fill in real values:
#   cp backend/.env.example backend/.env
#
# In Docker: these are injected via docker-compose environment block.
# Locally: loaded by your IDE or via `export $(cat .env | xargs)` before mvn.
# ============================================================

# ── Active Spring profile ────────────────────────────────────
# Options: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────
# Local dev: use localhost
# Docker:    use the service name 'db'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ev_renewable_db
DB_USERNAME=ev_user
DB_PASSWORD=change_me_strong_password

# ── Connection pool (HikariCP) ───────────────────────────────
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_MS=30000

# ── JWT Authentication ───────────────────────────────────────
# Must be at least 256 bits (32+ random characters).
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_a_256bit_random_secret_here
JWT_EXPIRATION_MS=86400000
# Refresh token expiry (7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ── Optimization service URL ─────────────────────────────────
# Spring Boot calls this service for route/charge optimization
OPTIMIZATION_SERVICE_URL=http://localhost:8001

# ── Mail (optional — for password reset emails) ──────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@evrenewable.com

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_LEVEL_SQL=DEBUG
