# ============================================================
# ROOT .gitignore — covers the entire monorepo
# ============================================================

# ── Environment files (NEVER commit real .env) ───────────────
.env
.env.local
.env.*.local
!.env.example

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.iml
*.ipr
*.iws
nbproject/
.nb-gradle/
*.sublime-workspace
*.sublime-project

# ── Logs ─────────────────────────────────────────────────────
*.log
*.log.*
logs/
!logs/.gitkeep

# ── Docker runtime artefacts ─────────────────────────────────
docker-compose.override.yml

# ── SSL / TLS certs ──────────────────────────────────────────
nginx/certs/*.pem
nginx/certs/*.crt
nginx/certs/*.key
nginx/certs/*.csr
!nginx/certs/.gitkeep

# ── Database backups (generated dumps, never source SQL) ─────
database/backups/*.sql
database/backups/*.dump
database/backups/*.gz
database/backups/*.tar
!database/backups/.gitkeep

# ── Compiled / build output ──────────────────────────────────
**/target/
**/dist/
**/build/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.class

# ── Secrets / credentials ────────────────────────────────────
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/
credentials.json
service-account.json

# ── Personal scratch files (anywhere in the repo) ────────────
**/run.txt
**/scratch.txt
**/notes.txt
**/todo.txt
