# ============================================================
# optimization/.env.example
# Used by: FastAPI (Python) via python-dotenv
# Copy to .env and fill in real values:
#   cp optimization/.env.example optimization/.env
#
# Loaded automatically if you call load_dotenv() in app/main.py
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8001
HOST=0.0.0.0
# Options: development | production
ENV=development
# Number of Uvicorn worker processes (set > 1 in production)
WORKERS=1

# ── Database ─────────────────────────────────────────────────
# Async SQLAlchemy DSN
# Local dev: postgresql+asyncpg://ev_user:password@localhost:5432/ev_renewable_db
# Docker:    postgresql+asyncpg://ev_user:password@db:5432/ev_renewable_db
DATABASE_URL=postgresql+asyncpg://ev_user:change_me_strong_password@localhost:5432/ev_renewable_db

# Sync DSN (used by Alembic migrations if added later)
DATABASE_SYNC_URL=postgresql://ev_user:change_me_strong_password@localhost:5432/ev_renewable_db

# ── Backend API ──────────────────────────────────────────────
# URL of the Spring Boot backend (for internal service calls)
BACKEND_API_URL=http://localhost:8080/api

# Internal service auth token (shared secret between backend and optimizer)
INTERNAL_API_KEY=change_me_internal_shared_secret

# ── Algorithm config ─────────────────────────────────────────
# Max iterations for optimisation algorithms
OPTIMIZATION_MAX_ITERATIONS=1000
# Time limit per optimisation run (seconds)
OPTIMIZATION_TIMEOUT_SECONDS=30

# ── Cost & emissions defaults ────────────────────────────────
# Fallback electricity rate (₹/kWh) when energy_signals has no price data
FALLBACK_RATE_INR_KWH=8.5
# Indian average grid CO₂ intensity (kg CO₂/kWh) for non-renewable share
GRID_CO2_KG_KWH=0.82

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Logging ──────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
