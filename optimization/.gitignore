# ============================================================
# optimization/.gitignore — Python 3.14 + FastAPI
# ============================================================

# ── Environment ──────────────────────────────────────────────
.env
.env.local
!.env.example

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python cache & compiled ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Distribution / packaging ─────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/

# ── Testing & coverage ───────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.coveragerc
nosetests.xml
test-results/
.tox/

# ── Type checking ────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ── Jupyter / analysis ───────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
!logs/.gitkeep

# ── Editor ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── ML / model artefacts ─────────────────────────────────────
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
models/*.bin

# ── OR-Tools solver output ───────────────────────────────────
*.pb
*.pbtxt
solver_output/
