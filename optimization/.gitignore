# ============================================================
# optimization/.gitignore — Python + FastAPI
# ============================================================

# ── Environment ──────────────────────────────────────────────
.env
.env.local
!.env.example

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Python cache & compiled ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ── Distribution / packaging ─────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/

# ── Testing & coverage ───────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.coveragerc
nosetests.xml
test-results/

# ── Type checking ────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Jupyter notebooks (if used for analysis) ─────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
!logs/.gitkeep

# ── Editor ───────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Model artefacts (ML weights / serialised objects) ────────
*.pkl
*.pickle
*.joblib
*.h5
*.pt
*.pth
models/*.bin
